# melytics release defaults — the web installer fills APP_KEY and APP_URL.
APP_NAME=melytics
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Optional "Continue with Google" on the sign-in screen: create an OAuth client
# at console.cloud.google.com (redirect URI: <your-url>/api/auth/google/callback),
# then uncomment and fill these — the button appears automatically.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Digest/alert emails. sendmail works on most shared hosts; if yours lacks it,
# switch to smtp (MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD) or log.
# The installer fills MAIL_FROM_ADDRESS from your domain.
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS=stats@example.com
MAIL_FROM_NAME=melytics
