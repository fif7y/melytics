# melytics — makes the bundle work when extracted straight into a web root
# (e.g. public_html) without repointing the docroot at public/.
# If your docroot IS public/, this file is never consulted. Apache/LiteSpeed.
#
# Every request is rewritten into public/, so the app internals (app/, vendor/,
# .env, …) are unreachable by URL: /vendor/x becomes public/vendor/x, which
# doesn't exist and 404s through Laravel. No explicit blocklist — the dashboard
# lives at /app/, which a "block app/" rule would 403 (learned the hard way).
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
