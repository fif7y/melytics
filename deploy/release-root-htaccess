# melytics — makes the bundle work when extracted straight into a web root
# (e.g. public_html) without repointing the docroot at public/.
# If your docroot IS public/, this file is never consulted. Apache/LiteSpeed.
#
# Every request is rewritten into public/, so the app internals (app/, vendor/,
# .env, …) are unreachable by URL: /vendor/x becomes public/vendor/x, which
# doesn't exist and 404s through Laravel. No explicit blocklist — the dashboard
# lives at /app/, which a "block app/" rule would 403 (learned the hard way).
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Baseline hardening headers for statically-served files (the SPA at /app/ is
# served by Apache, so the app's PHP middleware never sees it). CSP is set in the
# SPA's own <meta> — a strict script CSP here would break the inline-script
# install page. No-op where mod_headers is unavailable.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
